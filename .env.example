# 公開URL（末尾スラッシュなし）。独自ドメインにしたら書き換える
SITE_URL=https://jisshitsu-tanka.vercel.app

# 楽天ウェブサービス（https://webservice.rakuten.co.jp/ でアプリ登録）
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天のAPIデータで収益を得る場合は楽天アフィリエイト（本家）のIDを使う（規約上の条件）
RAKUTEN_AFFILIATE_ID=
# エンドポイントは楽天側のバージョン更新に合わせて変える
RAKUTEN_ITEM_SEARCH_URL=https://openapi.rakuten.co.jp/ichibams/api/IchibaItem/Search/20260401

# Yahoo!デベロッパーネットワーク（Client ID = appid）
YAHOO_APP_ID=

# アフィリエイトリンクを有効にするか（Vercel Pro＋表記を整えてから true に）
AFFILIATE_ENABLED=false
# もしものリンクのテンプレート。管理画面で作ったリンクの url= 以降を {url} に置き換えて貼る
MOSHIMO_YAHOO_LINK_TEMPLATE=
MOSHIMO_AMAZON_LINK_TEMPLATE=

# 独自ドメインへ移ったときだけ設定（vercel.app → 独自ドメインへ301）
CANONICAL_HOST=
VERCEL_PROJECT_HOST=

# 毎日の推移グラフ用（Supabaseのプロジェクト設定 → API）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cronの認証用（ランダムな長い文字列）
CRON_SECRET=

# 読み取りの二段目（自信の低い商品名だけAIで確認）。未設定ならルールだけで動く
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
